theorem polygonRecords_valid :
    polygonRecords.all (fun r => decide r.Valid) = true := by
  decide +kernel

theorem polygonRecords_length : polygonRecords.length = 815 := by decide +kernel

theorem recorded_polygon_excluded (r : PolygonRecord) (hr : r ∈ polygonRecords)
    (u m : Fin 8 → Space)
    (hdet : ∀ a b c, a ≠ b → a ≠ c → b ≠ c → triple (u a) (u b) (u c) ≠ 0)
    (hT : ∀ a b, contact u m a b = (r.E a b : ℝ) * ‖cross (u a) (u b)‖)
    (hχ : ∀ a b c, a < b → b < c →
      0 < (r.χ a b c : ℝ) * triple (u a) (u b) (u c)) : False := by
  apply polygonRecord_sound r ?_ u m hdet hT hχ
  exact of_decide_eq_true ((List.all_eq_true.mp polygonRecords_valid) r hr)

#print axioms polygonRecords_valid
#print axioms recorded_polygon_excluded

end LittlewoodCylinders.Upper
